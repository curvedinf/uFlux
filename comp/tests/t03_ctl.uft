; if / ifelse
1 'yes if
0 'yes if
1 'then 'els ifelse
0 'then 'els ifelse
; while with break/cont
; v12: break condition (i==7) folded into while-cond (break can't live in
; an if sub-body — the compiler rejects break/cont outside a loop body).
; continue condition (i==3) handled via ifelse that skips the print.
0 i!
'i_c 'i_b while
"" print
; for with break/cont
3 'fbody for
"" print
"done" print
ret
; --- quotation bodies (all continuations of the top-level _call body) ---
yes: "YES" print ret
then: "THEN" print ret
els: "ELS" print ret
i_c: i@ inc i! i@ 10 lt i@ 7 eq not and ret
i_b: i@ 3 eq not 'pr 'np ifelse 0 ret
pr: i@ print ret
np: 0 ret
fbody: k! k@ 1 eq 'fnp 'fpr ifelse ret
fpr: k@ print 0 ret
fnp: 0 ret

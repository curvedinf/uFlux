; build _arr [0..9]
0 10 range lst!
lst@ len _arr int a!
lst@ len 'cp for
a@ 2 vadd vsum print
a@ vsum print
a@ vmean print
a@ vmin print
a@ vmax print
a@ a2!
a2@ veadd vsum print
a@ a2!
a2@ vemul vsum print
a@ 1 vadd a1!
a1@ a1@ vediv vsum print
a@ 5 veq vcount print
a@ 4 vgt vcount print
a@ 4 vgt a@ 7 vlt vand vcount print
a@ 4 vgt a@ 7 vlt vor vcount print
a@ a4!
a4@ a4@ 4 vgt vgather vsum print
a@ 5 vge vnot vcount print
a@ 'sq vmap vsum print
a@ 0 'acc vfold print
; float arr
lst@ len _arr float f!
lst@ len 'cp2 for
f@ 0.5 vadd vsum print
f@ vmean print
; vargsort / vsearchsorted / vwhere
list 30 push 10 push 20 push s3!
s3@ len _arr int b!
s3@ len 'cp3 for
b@ vargsort idx!
idx@ 0 get print
b@ 15 vsearchsorted print
b@ b1!
b1@ b1@ b1@ 1 vlt vwhere vsum print
; sort arr
b@ sort sb!
sb@ 0 get print
sb@ 2 get print
ret
; --- quotation bodies ---
cp: k! lst@ k@ get v! a@ k@ v@ set ret
sq: x! x@ x@ * ret
acc: a! b! a@ b@ + ret
cp2: k! lst@ k@ get v! f@ k@ v@ set ret
cp3: k! s3@ k@ get v! b@ k@ v@ set ret

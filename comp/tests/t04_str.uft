"foo" "bar" cat print
list 1 push 2 push list 3 push cat len print
"hello world" 0 5 slice print
"hello" 2 -1 slice print
list 10 push 20 push 30 push 40 push 1 3 slice len print
"a,b,c" "," split len print
"a,b,c" "," split 1 get print
list "x" push "y" push ", " join print
"hello" "llo" find print
"hello" "l" "L" repl print
"  hi  " trim print
"abc" up print
"ABC" down print
"hello" "he" starts print
"hello" "lo" ends print
"abc123" "[0-9]+" match m!
m@ 0 get print
"a1b2" "[0-9]" "X" replace print
"a1b2c" "[0-9]" rsplit len print
"file.txt" "*.txt" glob print
"abc" "abc" eq print
"abc" "abd" lt print
"echo hi; echo err >&2" sh out! err! status!
status@ print
out@ print
err@ print

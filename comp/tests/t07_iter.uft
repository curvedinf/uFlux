; iterators
0 5 range iter 'dbl imap collect len "%d\n" print drop
0 5 range iter 'dbl imap collect 3 get "%d\n" print drop
0 10 range iter 'ev ifilter collect len "%d\n" print drop
jmp over
dbl: 2 mul ret
ev: 2 rem 0 eq ret
over:
; next
0 3 range iter it!
it@ next "%d %d\n" print drop
it@ next "%d %d\n" print drop
it@ next drop drop
it@ next "%d %d\n" print drop
; dict iter yields keys
dict d! d@ "k1" 1 set d@ "k2" 2 set
d@ iter collect len "%d\n" print drop
; str iter yields bytes
"AB" iter collect 1 get "%d\n" print drop
; json / unjson
"{\"a\": 1, \"b\": [1, 2, 3], \"s\": \"hi\"}" json j!
j@ "a" get "%d\n" print drop
j@ "b" get 2 get "%d\n" print drop
j@ "s" get "%s\n" print drop
j@ unjson "%s\n" print drop
"[1.5, 2]" json 0 get "%f\n" print drop
; try / retry
'good try "%d %d\n" print drop
'bad try "%d %d\n" print drop
0 cnt!
2 'flaky retry "%d %d\n" print drop
cnt@ "%d\n" print drop
jmp over2
good: 42 ret
bad: 1 0 div ret
flaky: cnt@ inc cnt! cnt@ 2 lt jz ok2 1 0 div ret ok2: 99 ret
over2:
; spawn
'work spawn c!
c@ deq "%d\n" print drop
jmp over3
work: 7 7 mul ret
over3:
"done\n" print drop

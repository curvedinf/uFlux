; c.ufm — binding manifest for USE"c" (links -lc)
import c"printf"(ptr,...)->int
import c"puts"(ptr)->int
import c"putchar"(int)->int
import c"fprintf"(ptr,ptr,...)->int
import c"sprintf"(ptr,ptr,...)->int
import c"malloc"(int)->ptr
import c"calloc"(int,int)->ptr
import c"realloc"(ptr,int)->ptr
import c"free"(ptr)->void
import c"memcpy"(ptr,ptr,int)->ptr
import c"memset"(ptr,int,int)->ptr
import c"memmove"(ptr,ptr,int)->ptr
import c"strlen"(ptr)->int
import c"strcmp"(ptr,ptr)->int
import c"strcpy"(ptr,ptr)->ptr
import c"exit"(int)->void

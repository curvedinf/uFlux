entry
1000 n!
argv len 1 gt 'setn if
0 count!
n@ 'yloop for
count@ "%d\n" print
ret
yloop:
ki!
ki@ 2.0 * n@ div 1.0 - ci!
n@ 'xloop for
0 ret
xloop:
kj!
kj@ 2.0 * n@ div 1.5 - cr!
0.0 zr!
0.0 zi!
0 esc!
50 'iloop for
0 ret
iloop:
esc@ 'ido if
0 ret
ido:
zr@ zr@ * zi@ zi@ * + 4.0 lt 'calc if
0 ret
calc:
zr@ zr@ * zi@ zi@ * - zrn!
zr@ zi@ 2.0 * * ci@ + zi!
zrn@ cr@ + zr!
0 ret
setn:
argv 1 get atoi n!
0 count!
n@ 'yloop2 for
count@ "%d\n" print
ret
yloop2:
ki!
ki@ 2.0 * n@ div 1.0 - ci!
n@ 'xloop2 for
0 ret
xloop2:
kj!
kj@ 2.0 * n@ div 1.5 - cr!
0.0 zr!
0.0 zi!
0 esc!
50 'iloop2 for
0 ret
iloop2:
esc@ 'ido2 if
0 ret
ido2:
zr@ zr@ * zi@ zi@ * + 4.0 lt 'calc2 if
0 ret
calc2:
zr@ zr@ * zi@ zi@ * - zrn!
zr@ zi@ 2.0 * * ci@ + zi!
zrn@ cr@ + zr!
0 ret

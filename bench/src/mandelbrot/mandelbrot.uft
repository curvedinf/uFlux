entry
1000 n!
argv len 1 gt 'useargv if
argv 1 get atoi n!
useargv:
0 count!
0 y!
'ycond 'ybody while
count@ "%d\n" print
ret
ycond:
y@ n@ lt ret
ybody:
y@ 2 * n@ div 1.0 - ci!
0 x!
'xcond 'xbody while
y@ 1 + y!
0 ret
xcond:
x@ n@ lt ret
xbody:
x@ 2 * n@ div 1.5 - cr!
0.0 zr!
0.0 zi!
0 it!
'icond 'ibody while
zr@ zr@ * zi@ zi@ * + 4.0 gt not 'inset if
x@ 1 + x!
0 ret
inset:
count@ 1 + count!
0 ret
ibody:
zr@ zr@ * zi@ zi@ * - zrn!
zr@ zi@ 2.0 * * ci@ + zi!
zrn@ cr@ + zr!
it@ 1 + it!
0 ret
icond:
it@ 50 lt zr@ zr@ * zi@ zi@ * + 4.0 lt and ret

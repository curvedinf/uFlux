; mandelbrot.uft — counts bounded points in the mandelbrot set
entry
1000 n!
argv len 1 gt 'setn if
0 count!
n@ 'ybody for
count@ "%d\n" print
ret

ybody:
  2.0 * n@ div 1.0 - ci!
  n@ 'xbody for
  ret

xbody:
  2.0 * n@ div 1.5 - cr!
  0.0 zr! 0.0 zi!
  0 ii!
  'icond 'ibody while
  zr@ zr@ * zi@ zi@ * + 4.0 lt
  count@ + count!
  ret

icond: ii@ 50 lt zr@ zr@ * zi@ zi@ * + 4.0 lt and ret
ibody:
  zr@ zr@ * zi@ zi@ * - zrn!
  zr@ zi@ 2.0 * * ci@ + zi!
  zrn@ cr@ + zr!
  ii@ 1 + ii!
  ret

setn:
  argv 1 get atoi n!
  0 count!
  n@ 'ybody for
  count@ "%d\n" print
  ret

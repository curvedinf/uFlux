import c"sqrt"(float)->float
av:
an! av!
an@ _arr float tmp!
0 i!
'icond 'ibody while
tmp@ ret
icond:
i@ an@ lt ret
ibody:
0 sm!
an@ 'avinner for
tmp@ i@ sm@ vset
i@ inc i!
0 ret
avinner:
k!
i@ k@ + sum!
sum@ sum@ 1 + * 2 div i@ + 1 + ea!
av@ k@ vget ea@ div sm@ + sm!
0 ret
atv:
bn! bv!
bn@ _arr float tmp!
0 i!
'cond2 'body2 while
tmp@ ret
cond2:
i@ bn@ lt ret
body2:
0 sm!
bn@ 'atinner for
tmp@ i@ sm@ vset
i@ inc i!
0 ret
atinner:
k!
k@ i@ + sum!
sum@ sum@ 1 + * 2 div k@ + 1 + ea!
bv@ k@ vget ea@ div sm@ + sm!
0 ret
atac:
n! x!
n@ an! n@ bn!
x@ n@ _call av t1!
t1@ n@ _call atv
ret
entry
5500 n!
hasargs 'setn if
n@ _arr float u!
n@ _arr float v!
n@ 'ubody for
10 'itbody for
0 vbv!
0 vv!
n@ 'sbody for
vbv@ vv@ div _call sqrt "%.9f" fmt print
ret
setn:
1 argi n!
0 ret
ubody:
k!
u@ k@ 1.0 vset
ret
itbody:
k!
u@ n@ _call atac v!
v@ n@ _call atac u!
ret
sbody:
k!
u@ k@ vget v@ k@ vget * vbv@ + vbv!
v@ k@ vget v@ k@ vget * vv@ + vv!
ret

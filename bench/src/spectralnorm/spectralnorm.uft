; spectralnorm.uft — v13: spectral norm of the Hilbert-like matrix (bench/SPEC.md)
5500 n!
has_args 'argn if
n@ n@ mul float array A!
n@ float array v!
n@ float array u!
n@ float array tmp!
; init A[i*n+j] = 1/((i+j)(i+j+1)/2 + i + 1), u[i] = 1.0, v[i] = 0.0
0 i!
'i_c 'i_b while
10 'power for
0 uvt! 0 vvt!
n@ 'dots for
uvt@ vvt@ div sqrt "%.9f" format print
ret
argn:
  1 arg_index n!
  ret
i_c:
  ret i@ n@ lt
i_b:
  u@ i@ 1.0 array_set
  v@ i@ 0.0 array_set
  0 j!
  'j_c 'j_b while
  ret i@ 1 add i!
j_c:
  ret j@ n@ lt
j_b:
  i@ j@ add ij!
  ij@ ij@ 1 add mul 2 div i@ add 1 add den!
  A@ i@ n@ mul j@ add 1.0 den@ div array_set
  ret j@ 1 add j!
; power iteration (matches reference): v = AtAv(u), then u = AtAv(v)
power: k!
  n@ 'mv1 for
  n@ 'tm1 for
  n@ 'mv2 for
  n@ 'tm2 for
  ret
; mv1: tmp[i] = sum_j A[i*n+j] * u[j]
mv1: i!
  0 s! 0 j!
  'm1c 'm1b while
  tmp@ i@ s@ array_set
  ret 0
m1c:
  ret j@ n@ lt
m1b:
  A@ i@ n@ mul j@ add array_get u@ j@ array_get mul s@ add s!
  ret j@ 1 add j!
; tm1: v[i] = sum_j A[j*n+i] * tmp[j]
tm1: i!
  0 s! 0 j!
  't1c 't1b while
  v@ i@ s@ array_set
  ret 0
t1c:
  ret j@ n@ lt
t1b:
  A@ j@ n@ mul i@ add array_get tmp@ j@ array_get mul s@ add s!
  ret j@ 1 add j!
; mv2: tmp[i] = sum_j A[i*n+j] * v[j]
mv2: i!
  0 s! 0 j!
  'm2c 'm2b while
  tmp@ i@ s@ array_set
  ret 0
m2c:
  ret j@ n@ lt
m2b:
  A@ i@ n@ mul j@ add array_get v@ j@ array_get mul s@ add s!
  ret j@ 1 add j!
; tm2: u[i] = sum_j A[j*n+i] * tmp[j]
tm2: i!
  0 s! 0 j!
  't2c 't2b while
  u@ i@ s@ array_set
  ret 0
t2c:
  ret j@ n@ lt
t2b:
  A@ j@ n@ mul i@ add array_get tmp@ j@ array_get mul s@ add s!
  ret j@ 1 add j!
dots: k!
  u@ k@ array_get v@ k@ array_get mul uvt@ add uvt!
  v@ k@ array_get v@ k@ array_get mul vvt@ add vvt!
  ret 0

import c"sqrt"(float)->float
av:
an! av!
an@ arr float tmp!
0 i!
'avcond 'avbody while
tmp@ ret
avcond:
i@ an@ lt ret
avbody:
0 sm!
0 j!
'avinner 'avinner2 while
tmp@ i@ sm@ vset
i@ 1 + i!
0 ret
avinner:
j@ an@ lt ret
avinner2:
i@ j@ + dup 1 + * 2 div i@ + 1 + ea!
av@ j@ vget ea@ div sm@ + sm!
j@ 1 + j!
0 ret
atv:
bn! bv!
bn@ arr float tmp!
0 i!
'atcond 'atbody while
tmp@ ret
atcond:
i@ bn@ lt ret
atbody:
0 sm!
0 j!
'atinner 'atinner2 while
tmp@ i@ sm@ vset
i@ 1 + i!
0 ret
atinner:
j@ bn@ lt ret
atinner2:
j@ i@ + dup 1 + * 2 div j@ + 1 + ea!
bv@ j@ vget ea@ div sm@ + sm!
j@ 1 + j!
0 ret
atac:
n! x!
n@ an! n@ bn!
x@ n@ call av t1!
t1@ n@ call atv
ret
itcond:
it@ 10 lt ret
itbody:
u@ n@ call atac v!
v@ n@ call atac u!
it@ 1 + it!
0 ret
entry
5500 n!
argv len 1 gt 'setn if
n@ arr float u!
n@ arr float v!
0 k!
'ucond 'ubody while
0 it!
'itcond 'itbody while
0 vbv!
0 vv!
0 k!
'scond 'sbody while
vbv@ vv@ div call sqrt "%.9f\n" print
ret
setn:
argv 1 get atoi n!
0 ret
ucond:
k@ n@ lt ret
ubody:
u@ k@ 1.0 vset
k@ 1 + k!
0 ret
scond:
k@ n@ lt ret
sbody:
u@ k@ vget v@ k@ vget * vbv@ + vbv!
v@ k@ vget v@ k@ vget * vv@ + vv!
k@ 1 + k!
0 ret

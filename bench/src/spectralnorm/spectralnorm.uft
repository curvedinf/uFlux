import c"sqrt"(float)->float
av:
an! av!
an@ _arr float tmp!
an@ 'avbody for
tmp@ ret
avbody:
i!
0 sm!
an@ 'avinner for
tmp@ i@ sm@ vset
ret
avinner:
j!
i@ j@ + dup 1 + * 2 div i@ + 1 + ea!
av@ j@ vget ea@ div sm@ + sm!
ret
atv:
bn! bv!
bn@ _arr float tmp!
bn@ 'atbody for
tmp@ ret
atbody:
i!
0 sm!
bn@ 'atinner for
tmp@ i@ sm@ vset
ret
atinner:
j!
j@ i@ + dup 1 + * 2 div j@ + 1 + ea!
bv@ j@ vget ea@ div sm@ + sm!
ret
atac:
n! x!
n@ an! n@ bn!
x@ n@ _call av t1!
t1@ n@ _call atv
ret
entry
5500 n!
hasargs 'setn if
n@ _arr float u!
n@ _arr float v!
n@ 'ubody for
10 'itbody for
0 vbv!
0 vv!
n@ 'sbody for
vbv@ vv@ div _call sqrt "%.9f\n" print
ret
setn:
1 argi n!
0 ret
ubody:
k!
u@ k@ 1.0 vset
ret
itbody:
drop
u@ n@ _call atac v!
v@ n@ _call atac u!
ret
sbody:
k!
u@ k@ vget v@ k@ vget * vbv@ + vbv!
v@ k@ vget v@ k@ vget * vv@ + vv!
ret

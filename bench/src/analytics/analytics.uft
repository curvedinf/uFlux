fl:
drop drop
^first@ not 'proc if
0 ^first!
0 ret
proc:
7 fatoi units!
10 fatof total!
^tr@ total@ + ^tr!
^tu@ units@ + ^tu!
^rr@ 2 total@ faddto
^pr@ 4 total@ faddto
^cr@ 3 total@ faddto
^rows@ 1 + ^rows!
0 ret
emitrow:
idx!
curdict@ n@ topn pairs!
pairs@ idx@ get kv!
kv@ 0 get name!
kv@ 1 get val!
rank@ 1 + rank!
prefix@ rank@ name@ val@ "%s%d: %s $%.2f\n" print drop
ret
useargv:
argv 1 get p!
0 ret
entry
0 ^tr! 0 ^tu! 0 ^rows! 1 ^first!
dict ^rr!
dict ^pr!
dict ^cr!
"bench/data/sales.csv" p!
hasargs 'useargv if
p@ "," 0 'fl fsplit drop
"=== DATA ANALYTICS RESULTS ===\n" print drop
^rows@ "total_rows: %d\n" print
^tr@ "total_revenue: %.2f\n" print
^tr@ ^rows@ div "avg_order: %.2f\n" print
^tu@ "total_units: %d\n" print
"region_" prefix!
^rr@ curdict! 6 n! 0 rank!
curdict@ n@ topn pairs!
pairs@ len 'emitrow for
"product_" prefix!
^pr@ curdict! 5 n! 0 rank!
curdict@ n@ topn pairs!
pairs@ len 'emitrow for
"country_" prefix!
^cr@ curdict! 3 n! 0 rank!
curdict@ n@ topn pairs!
pairs@ len 'emitrow for
ret

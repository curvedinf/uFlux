fl:
nf! acc!
^first@ 'hdr 'proc ifelse
acc@ ret
hdr:
0 ^first!
ret
proc:
^rr@ 2 10 fatof faddto
^pr@ 4 10 fatof faddto
^cr@ 3 10 fatof faddto
^gd@ "u" 7 fatoi addto
^gd@ "t" 10 fatof addto
^gd@ "l" 1 addto
ret
emitrow:
idx!
curdict@ n@ topn pairs!
pairs@ idx@ get kv!
kv@ 0 get name!
kv@ 1 get val!
rank@ 1 + rank!
prefix@ rank@ name@ val@ "%s%d: %s $%.2f" fmt print
ret
useargv:
argv 1 get p!
0 ret
entry
0 ^rows! 1 ^first!
dict ^gd!
"r" 0 ^gd@ set
"t" 0.0 ^gd@ set
"l" 0 ^gd@ set
"u" 0 ^gd@ set
dict ^rr!
dict ^pr!
dict ^cr!
"bench/data/sales.csv" p!
hasargs 'useargv if
p@ "," 0 'fl fsplit
"=== DATA ANALYTICS RESULTS ===" print
^gd@ "l" getq "total_rows: %d" fmt print
^gd@ "t" getq "total_revenue: %.2f" fmt print
^gd@ "t" getq ^gd@ "l" getq div "avg_order: %.2f" fmt print
^gd@ "u" getq "total_units: %d" fmt print
"region_" prefix!
^rr@ curdict! 6 n! 0 rank!
curdict@ n@ topn pairs!
pairs@ len 'emitrow for
"product_" prefix!
^pr@ curdict! 5 n! 0 rank!
curdict@ n@ topn pairs!
pairs@ len 'emitrow for
"country_" prefix!
^cr@ curdict! 3 n! 0 rank!
curdict@ n@ topn pairs!
pairs@ len 'emitrow for
ret

fl:
drop drop
^first@ not 'proc if
0 ^first!
0 ret
proc:
7 fatoi units!
10 fatof total!
^tr@ total@ + ^tr!
^tu@ units@ + ^tu!
^rr@ 2 total@ faddto
^pr@ 4 total@ faddto
^cr@ 3 total@ faddto
^rows@ 1 + ^rows!
0 ret
selmax:
drop
-1.0 bestv! "" bestk!
kl@ len 'selscan for
rank@ 1 + rank!
prefix@ rank@ bestk@ curdict@ bestk@ getq "%s%d: %s $%.2f\n" print drop
^sel@ bestk@ 1 addto
ret
selscan:
k!
kl@ k@ get name!
^sel@ name@ getq not 'selchk if
ret
selchk:
curdict@ name@ getq v!
v@ bestv@ gt 'selupd if
0 ret
selupd: v@ bestv! name@ bestk! 0 ret
useargv:
argv 1 get p!
0 ret
entry
0 ^tr! 0 ^tu! 0 ^rows! 1 ^first!
dict ^rr!
dict ^pr!
dict ^cr!
"bench/data/sales.csv" p!
argv len 1 gt 'useargv if
p@ "," 0 'fl fsplit drop
"=== DATA ANALYTICS RESULTS ===\n" print drop
^rows@ "total_rows: %d\n" print
^tr@ "total_revenue: %.2f\n" print
^tr@ ^rows@ div "avg_order: %.2f\n" print
^tu@ "total_units: %d\n" print
"region_" prefix!
^rr@ curdict! ^rr@ keys rk! rk@ sort rk! rk@ kl!
dict ^sel! 0 rank! 6 'selmax for
"product_" prefix!
^pr@ curdict! ^pr@ keys pk! pk@ sort pk! pk@ kl!
dict ^sel! 0 rank! 5 'selmax for
"country_" prefix!
^cr@ curdict! ^cr@ keys ck! ck@ sort ck! ck@ kl!
dict ^sel! 0 rank! 3 'selmax for
ret

fl:
ln! drop
ln@ " " find sp!
ln@ 0 sp@ slice ip!
sc@ ip@ getq 1 + v!
sc@ ip@ v@ set
ln@ "[" find bp!
bp@ 13 + hp!
ln@ hp@ get d0!
ln@ hp@ 1 + get d1!
d0@ 48 - 10 * d1@ 48 - + hr!
hrs@ hr@ getq 1 + hv!
hrs@ hr@ hv@ set
ln@ "1.1\" " find qp!
qp@ 5 + p1!
ln@ p1@ get sb!
sb@ 48 - cls!
sd@ cls@ getq 1 + sv!
sd@ cls@ sv@ set
ln@ len ell!
ln@ p1@ ell@ slice rest!
rest@ " " find sp2!
sp2@ 1 + bp2!
0 by!
rest@ bp2@ getq ch!
'bcond 'bbody while
tb@ by@ + tb!
tl@ 1 + tl!
0 ret
bcond:
ch@ 48 lt ch@ 57 gt or not ret
bbody:
by@ 10 * ch@ 48 - + by!
bp2@ 1 + bp2!
rest@ bp2@ getq ch!
0 ret
mkp:
ipk! ipcnt!
rank@ 1 + rank!
rank@ ipk@ ipcnt@
"top_ip_%d: %s (%d)\n" print drop
0 ret
hpf:
k!
hrs@ k@ getq hv!
k@ hv@ "hour_%02d: %d\n" print drop
ret
ipf:
k!
iplist@ k@ get ipk!
sc@ ipk@ getq ipcnt!
rank@ 10 lt 'mkp if
ret
useargv:
argv 1 get p!
0 ret
entry
0 tl! 0 tb! 0 rank!
dict sc!
dict hrs!
dict sd!
"bench/data/access.log" p!
argv len 1 gt 'useargv if
p@ 0 'fl ffold drop
"=== LOG EXTRACTION RESULTS ===\n" print drop
tl@ "total_lines: %d\n" print
tb@ "total_bytes: %d\n" print
sd@ 2 getq "status_2xx: %d\n" print drop
sd@ 3 getq "status_3xx: %d\n" print drop
sd@ 4 getq "status_4xx: %d\n" print drop
sd@ 5 getq "status_5xx: %d\n" print drop
24 'hpf for
sc@ keys iplist!
iplist@ sort iplist!
iplist@ len 'ipf for
ret

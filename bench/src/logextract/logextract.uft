jmp main
fl:
ln! drop
ln@ " " find sp!
ln@ 0 sp@ slice ip!
sc@ ip@ getq 1 + v!
sc@ ip@ v@ set
ln@ "[" find bp!
bp@ 12 + hp!
ln@ hp@ get hr!
hrs@ hr@ getq 1 + hv!
hrs@ hr@ hv@ set
ln@ "1.1\" " find qp!
qp@ 5 + p1!
ln@ p1@ get sb!
sb@ 48 - cls!
cls@ 2 eq jz n2
s2@ 1 + s2!
n2:
cls@ 3 eq jz n3
s3@ 1 + s3!
n3:
cls@ 4 eq jz n4
s4@ 1 + s4!
n4:
cls@ 5 eq jz n5
s5@ 1 + s5!
n5:
ln@ len ell!
ln@ p1@ ell@ slice rest!
rest@ " " find sp2!
sp2@ 1 + byp!
0 by!
rest@ byp@ get ch!
'bcond 'bbody while
tb@ by@ + tb!
tl@ 1 + tl!
0 ret
bcond:
ch@ 48 lt jz bc2
0 ret
bc2:
ch@ 57 gt jz bc3
0 ret
bc3:
1 ret
bbody:
by@ 10 * ch@ 48 - + by!
byp@ 1 + byp!
rest@ byp@ get ch!
0 ret
mkp:
ipk! ipcnt!
rank@ 1 + rank!
rank@ ipk@ ipcnt@
"top_ip_%d: %s (%d)\n" print drop
0 ret
main:
0 tl! 0 tb! 0 s2! 0 s3! 0 s4! 0 s5! 0 rank!
dict sc!
dict hrs!
argv len 1 gt jz defpath
argv 1 get p!
jmp go
defpath:
"bench/data/access.log" p!
go:
p@ 0 'fl ffold drop
"=== LOG EXTRACTION RESULTS ===\n" print drop
tl@ "total_lines: %d\n" print
tb@ "total_bytes: %d\n" print
s2@ "status_2xx: %d\n" print
s3@ "status_3xx: %d\n" print
s4@ "status_4xx: %d\n" print
s5@ "status_5xx: %d\n" print
0 24 range 'hpf for
hpf:
k!
hrs@ k@ getq hv!
k@ hv@ "hour_%02d: %d\n" print drop
0 ret
sc@ keys iplist!
iplist@ sort iplist!
iplist@ len 'ipf for
ipf:
k!
iplist@ k@ get ipk!
sc@ ipk@ getq ipcnt!
rank@ 10 lt jz done
ipk! ipcnt!
rank@ 1 + rank!
rank@ ipk@ ipcnt@
"top_ip_%d: %s (%d)\n" print drop
done:
0 ret

; logextract.uft — v13: access-log analytics (bench/SPEC.md)
; Tokens: [0] IP, [3] timestamp (HH at offset 13), [8] status, [9] bytes
0 ^lines! 0 ^bytes!
dict ^hours! dict ^ips! dict ^status!
argv 1 get f!
f@ " " 0 'row file_split_lines
"=== LOG EXTRACTION RESULTS ===" print
^lines@ "total_lines: %d" format print
^bytes@ "total_bytes: %d" format print
^status@ 2 get_or_zero "status_2xx: %d" format print
^status@ 3 get_or_zero "status_3xx: %d" format print
^status@ 4 get_or_zero "status_4xx: %d" format print
^status@ 5 get_or_zero "status_5xx: %d" format print
24 'hour for
^ips@ 10 top_n ip_list!
ip_list@ length 'topip for
ret
row: acc! n!
  n@ 10 lt 'skip 'proc if_else
  ret acc@
skip:
  ret
proc:
  ^hours@ 3 13 2 field_slice parse_int 1 add_to
  ^ips@ 0 field_inc
  ^status@ 8 0 field_byte 48 sub 1 add_to
  ^bytes@ 9 field_int add ^bytes!
  ^lines@ 1 add ^lines!
  ret
hour: k!
  ^hours@ k@ get_or_zero v!
  k@ v@ "hour_%02d: %d" format print
  ret 0
topip: k!
  ip_list@ k@ get p!
  p@ 0 get nm! p@ 1 get v!
  k@ 1 add nm@ v@ "top_ip_%d: %s (%d)" format print
  ret 0

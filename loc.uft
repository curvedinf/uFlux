; LOC counter — pure µFlux (text mode)
; Counts lines in all project source files, broken down by extension.
; `sh` enumerates files only; counting uses `ffold` per file.

"find . -type f \\( -name '*.rs' -o -name '*.c' -o -name '*.h' -o -name '*.py' -o -name '*.uf' -o -name '*.uft' -o -name '*.ufm' -o -name '*.cpp' -o -name '*.js' \\) -not -path './.git/*' -not -path './comp/target/*' -not -path './.bench-venv/*' -not -path './trans/trans' -not -path './trans/trans_bin' -not -path './bench/src/*/*_bin' -not -path './bench/src/*/*_uf' -not -path './bench/src/*/*_rs' -not -path './bench/src/*/*_cpp' | sort" sh drop drop
"\n" split 'nz filter
^files!

dict ^byext!
0 ^total!
0 ^nfiles!

^files@ len 'walk for
"ext       lines\n" print drop
"---  ----------\n" print drop
^byext@ sortkeys ^sk!
^sk@ len 'pr for
"---  ----------\n" print drop
^total@ ^nfiles@ "ALL  %10d   (%d files)\n" print drop
ret

; --- label bodies ---
nz: len 0 gt ret
cstep: drop inc ret
walk:
  k! ^files@ k@ get trim ^f!
  ^f@ 0 'cstep ffold ^c!
  ^f@ "." split dup len dec get ^e!
  ^total@ ^c@ add ^total!
  ^nfiles@ inc ^nfiles!
  ^byext@ ^e@ ^c@ addto
  ret
pr:
  k! ^sk@ k@ get
  ^byext@ ovr get
  ".%-4s %10d\n" print drop
  ret

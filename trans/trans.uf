; trans.uf — C subset -> uFlux v10 text-encoding transpiler, written in uFlux
; v10: no jmp/jz/je; emits if/ifelse/while + native comparison opcodes
import c"printf"(ptr,...)->int
import c"malloc"(int)->ptr
import c"fopen"(ptr,ptr)->ptr
import c"fseek"(ptr,int,int)->int
import c"ftell"(ptr)->int
import c"fread"(ptr,int,int,ptr)->int
import c"fclose"(ptr)->int
import c"puts"(ptr)->int
import c"exit"(int)->void
import c"strlen"(ptr)->int
import c"strcmp"(ptr,ptr)->int
import c"strcpy"(ptr,ptr)->ptr

; ---- macros (must precede first use) ----
macro em { call emit }
macro emn { call emitn }
macro psh { ps@ swp push ps! }
macro spop { ps@ pop }
macro speek { ps@ dup len 1 - get }
macro expect { e! call tk e@ call streq not 'exf if call adv }

; ---- output buffering (macros) ----
macro lpush { ls@ swp push ls! }
macro lpop { ls@ pop }
; ---- output buffering ----
emit: s!
  inq@ 'em_q 'em_o ifelse
  ret
em_o: s@ "%s" print drop 0 ret
em_q: qout@ s@ cat qout! 0 ret
emitn: n!
  n@ "%d" fmt sn!
  inq@ 'en_q 'en_o ifelse
  ret
en_o: sn@ "%s" print drop 0 ret
en_q: qout@ sn@ cat qout! 0 ret

; ---- leaf utilities ----
streq: b2! a2! a2@ b2@ call strcmp not ret
die: call puts 1 call exit ret
tk: toks@ pi@ get ret
tk1: toks@ pi@ 1 + get ret
adv: pi@ 1 + pi! ret
newlbl: lbl@ 1 + lbl! lbl@ ret
exf: "parse error: expected " e@ cat " got " cat call tk cat "\n" cat call die

istype: it!
  it@ "int" call streq it@ "char" call streq + it@ "void" call streq +
  it@ "long" call streq + it@ "short" call streq + it@ "unsigned" call streq +
  it@ "signed" call streq + it@ "const" call streq + it@ "static" call streq +
  ret

ptype: 'ptc 'ptb while ret
ptc: call tk call istype call tk "*" call streq + ret
ptb: call adv 0 ret

newvar: nv!
  "v" fid@ "%d" fmt cat nv2!
  fid@ 1 + fid!
  vars@ nv@ nv2@ set
  nv2@ ret

findvar: nv!
  vars@ nv@ getq dup not 'fvno if ret
fvno: drop "undefined variable: " nv@ cat "\n" cat call die

; trymatch: pat -> match length at pos, or -1
trymatch: tm_pat!
  src@ pos@ srclen@ slice tm_pat@ match 'tm_yes 'tm_no ifelse
  tmr@ ret
tm_yes: 0 get call strlen tmr! 0 ret
tm_no: drop -1 tmr! 0 ret

; ---- lexer ----
lexl_c:
  'skp_c 'skp_b while
  pos@ srclen@ lt ret
lexl_b:
  src@ pos@ srclen@ slice rest!
  rest@ "^\"([^\"\\\\]|\\\\.)*\"" call trymatch dup -1 eq not 'lex_str 'lex_n1 ifelse
  0 ret
lex_str: ln! call lput 0 ret
lex_n1: drop
  rest@ "^'([^'\\\\]|\\\\.)*'" call trymatch dup -1 eq not 'lex_chr 'lex_n2 ifelse
  0 ret
lex_chr: ln! call lput 0 ret
lex_n2: drop
  rest@ "^(0[xX][0-9a-fA-F]+|[0-9]+)" call trymatch dup -1 eq not 'lex_num 'lex_n3 ifelse
  0 ret
lex_num: ln! call lput 0 ret
lex_n3: drop
  rest@ "^[A-Za-z_][A-Za-z0-9_]*" call trymatch dup -1 eq not 'lex_id 'lex_n4 ifelse
  0 ret
lex_id: ln! call lput 0 ret
lex_n4: drop
  rest@ "^(<<=|>>=|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|\\+=|-=|\\*=|/=|%=|<<|>>)" call trymatch dup -1 eq not 'lex_mop 'lex_n5 ifelse
  0 ret
lex_mop: ln! call lput 0 ret
lex_n5: drop 1 ln! call lput 0 ret
lput: src@ pos@ pos@ ln@ + slice toks@ swp push toks! pos@ ln@ + pos! ret

; skip phase
skp_c:
  src@ pos@ srclen@ slice rest!
  rest@ "^[\t\n\r ]+" call trymatch -1 eq not
  rest@ "//" starts +
  rest@ "/*" starts +
  rest@ "#" starts +
  ret
skp_b:
  rest@ "^[\t\n\r ]+" call trymatch dup -1 eq not 'sb_ws 'sb_n1 ifelse 0 ret
sb_ws: pos@ + pos! 0 ret
sb_n1: drop rest@ "//" starts 'sb_lc 'sb_n2 ifelse 0 ret
sb_lc: rest@ "\n" find dup -1 eq 'sb_lc_eof 'sb_lc_nl ifelse 0 ret
sb_lc_nl: pos@ + 1 + pos! 0 ret
sb_lc_eof: drop srclen@ pos! 0 ret
sb_n2: drop rest@ "/*" starts 'sb_bc 'sb_n3 ifelse 0 ret
sb_bc: rest@ "*/" find dup -1 eq 'sb_bc_eof 'sb_bc_end ifelse 0 ret
sb_bc_end: pos@ + 2 + pos! 0 ret
sb_bc_eof: drop srclen@ pos! 0 ret
sb_n3: drop rest@ "#" starts 'sb_pp 'sb_done ifelse 0 ret
sb_pp: rest@ "\n" find dup -1 eq 'sb_pp_eof 'sb_pp_nl ifelse 0 ret
sb_pp_nl: pos@ + 1 + pos! 0 ret
sb_pp_eof: drop srclen@ pos! 0 ret
sb_done: 0 ret

; ---- expression parser ----
pexpr: call passign ret

passign:
  vars@ call tk getq dup not 'pa_plor 'pa_cdr ifelse ret
pa_plor: drop call plor 0 ret
pa_cdr:
  psh call tk1 psh
  speek "=" call streq speek "+=" call streq + speek "-=" call streq +
  speek "*=" call streq + speek "/=" call streq + speek "%=" call streq +
  not 'pa_na 'pa_as ifelse 0 ret
pa_na: spop drop spop drop call plor 0 ret
pa_as:
  speek "/=" call streq speek "%=" call streq + 'pa_die if
  speek "=" call streq 'pa_simple 'pa_compound ifelse 0 ret
pa_simple:
  call adv call adv call passign "dup " call emit
  spop drop spop "%s!\n" fmt call emit 0 ret
pa_compound:
  call adv call adv ps@ dup len 2 - get "%s@ " fmt call emit call passign
  speek 0 1 slice call emit " dup " call emit spop drop
  spop "%s!\n" fmt call emit 0 ret
pa_die: "no division in subset" call die

plor: call pland 'plo_c 'plo_b while ret
plo_c: call tk "||" call streq ret
plo_b: call adv call pland "not not swp not not or " call emit 0 ret

pland: call peq 'pla_c 'pla_b while ret
pla_c: call tk "&&" call streq ret
pla_b: call adv call peq "not not swp not not and " call emit 0 ret

peq: call prel 'peq_c 'peq_b while ret
peq_c: call tk "==" call streq call tk "!=" call streq + ret
peq_b: call tk "==" call streq 'peq_eq 'peq_ne ifelse 0 ret
peq_eq: call adv call prel "eq " call emit 0 ret
peq_ne: call adv call prel "eq not " call emit 0 ret

prel: call padd 'prl_c 'prl_b while ret
prl_c: call tk "<" call streq call tk "<=" call streq + call tk ">" call streq + call tk ">=" call streq + ret
prl_b: call tk "<" call streq 'prl_lt 'prl_n1 ifelse 0 ret
prl_lt: call adv call padd "lt " call emit 0 ret
prl_n1: call tk "<=" call streq 'prl_le 'prl_n2 ifelse 0 ret
prl_le: call adv call padd "gt not " call emit 0 ret
prl_n2: call tk ">" call streq 'prl_gt 'prl_ge ifelse 0 ret
prl_gt: call adv call padd "gt " call emit 0 ret
prl_ge: call adv call padd "lt not " call emit 0 ret

padd: call pmul 'pad_c 'pad_b while ret
pad_c: call tk "+" call streq call tk "-" call streq + ret
pad_b: call tk "+" call streq 'pad_plus 'pad_minus ifelse 0 ret
pad_plus: call adv call pmul "+ " call emit 0 ret
pad_minus: call adv call pmul "- " call emit 0 ret

pmul: call punary 'pm_c 'pm_b while
  call tk "/" call streq call tk "%" call streq + 'pm_die if
  ret
pm_c: call tk "*" call streq ret
pm_b: call adv call punary "* " call emit 0 ret
pm_die: "no division in subset" call die

punary:
  call tk "-" call streq 'pu_neg 'pu_c1 ifelse ret
pu_c1: call tk "!" call streq 'pu_not 'pu_c2 ifelse 0 ret
pu_c2: call tk "~" call streq 'pu_bnot 'pu_c3 ifelse 0 ret
pu_c3: call tk "+" call streq 'pu_pos 'pu_c4 ifelse 0 ret
pu_c4: call tk "++" call streq 'pu_inc 'pu_c5 ifelse 0 ret
pu_c5: call tk "--" call streq 'pu_dec 'pu_post ifelse 0 ret
pu_neg: call adv "0 " call emit call punary "- " call emit 0 ret
pu_not: call adv call punary "not " call emit 0 ret
pu_bnot: call adv call punary "-1 swp - " call emit 0 ret
pu_pos: call adv call punary 0 ret
pu_inc:
  call adv vars@ call tk getq dup not 'pu_inc_e if
  call adv dup "%s@ 1 + dup %s! " fmt call emit 0 ret
pu_inc_e: "++ needs a variable" call die
pu_dec:
  call adv vars@ call tk getq dup not 'pu_dec_e if
  call adv dup "%s@ 1 - dup %s! " fmt call emit 0 ret
pu_dec_e: "-- needs a variable" call die
; postfix ++/--: use if instead of while to avoid nested while issues
pu_post: "" lasts! call pprim call tk "++" call streq 'pun_inc 'pun_chk2 ifelse 0 ret
pun_chk2: call tk "--" call streq 'pun_dec 'pun_done ifelse 0 ret
pun_inc:
  lasts@ "" call streq 'pp_inc_err if
  call adv lasts@ dup "%s@ 1 + %s! " fmt call emit 0 ret
pp_inc_err: "postfix ++ needs a variable" call die
pun_dec:
  lasts@ "" call streq 'pp_dec_err if
  call adv lasts@ dup "%s@ 1 - %s! " fmt call emit 0 ret
pp_dec_err: "postfix -- needs a variable" call die
pun_done: 0 ret

pprim: call tk ptk!
  ptk@ "[0-9]*" glob 'pp_num 'pp_n1 ifelse ret
pp_n1: ptk@ "'" starts 'pp_char 'pp_n2 ifelse 0 ret
pp_n2: ptk@ "\"" starts 'pp_str 'pp_n3 ifelse 0 ret
pp_n3: ptk@ "(" call streq 'pp_paren 'pp_n4 ifelse 0 ret
pp_n4: ptk@ "argc" call streq 'pp_argc 'pp_n5 ifelse 0 ret
pp_n5: ptk@ "argv" call streq 'pp_argv 'pp_n6 ifelse 0 ret
pp_n6: ptk@ "__byte" call streq 'pp_byte 'pp_n7 ifelse 0 ret
pp_n7: ptk@ "NULL" call streq 'pp_null 'pp_n8 ifelse 0 ret
pp_n8: ptk@ "EOF" call streq 'pp_eof 'pp_n9 ifelse 0 ret
pp_n9: call tk1 "(" call streq 'pp_func 'pp_var ifelse 0 ret

pp_num:
  ptk@ "^(0[xX][0-9a-fA-F]+|[0-9]+)" match drop 0 get call emit " " call emit call adv 0 ret
pp_str: ptk@ call emit " " call emit call adv "" lasts! 0 ret
pp_paren: call adv call pexpr ")" expect "" lasts! 0 ret
pp_argc: call adv "extern \"uf_argc\" loadx " call emit "" lasts! 0 ret
pp_argv: call adv "[" expect call pexpr "]" expect
  "extern \"uf_argv\" loadx swp 8 * + loadx " call emit "" lasts! 0 ret
pp_byte: call adv "(" expect call pexpr ")" expect "loadx 255 and " call emit "" lasts! 0 ret
pp_null: call adv "0 " call emit "" lasts! 0 ret
pp_eof: call adv "-1 " call emit "" lasts! 0 ret

pp_char:
  ptk@ 1 ptk@ call strlen 1 - slice ci!
  ci@ "\\" starts 'pp_esc 'pp_charlit ifelse 0 ret
pp_charlit: ci@ loadx 255 and call emitn " " call emit call adv 0 ret
pp_esc:
  ci@ "\\n" call streq 'pe_n 'pe_t1 ifelse 0 ret
pe_n: 10 call emitn " " call emit call adv 0 ret
pe_t1: ci@ "\\t" call streq 'pe_t 'pe_r1 ifelse 0 ret
pe_t: 9 call emitn " " call emit call adv 0 ret
pe_r1: ci@ "\\r" call streq 'pe_r 'pe_01 ifelse 0 ret
pe_r: 13 call emitn " " call emit call adv 0 ret
pe_01: ci@ "\\0" call streq 'pe_0 'pe_bs1 ifelse 0 ret
pe_0: 0 call emitn " " call emit call adv 0 ret
pe_bs1: ci@ "\\\\" call streq 'pe_bs 'pe_sq1 ifelse 0 ret
pe_bs: 92 call emitn " " call emit call adv 0 ret
pe_sq1: ci@ "\\'" call streq 'pe_sq 'pe_bad ifelse 0 ret
pe_sq: 39 call emitn " " call emit call adv 0 ret
pe_bad: "bad char escape" call die

pp_func:
  ptk@ psh call adv call adv
  call tk ")" call streq 'ppf_noargs 'ppf_args ifelse
  ")" expect spop "call %s " fmt call emit "" lasts! 0 ret
ppf_noargs: 0 ret
ppf_args: call pexpr 'ppf_c 'ppf_b while 0 ret
ppf_c: call tk "," call streq ret
ppf_b: call adv call pexpr 0 ret

pp_var: call tk1 "[" call streq 'pp_arr 'pp_vr ifelse 0 ret
pp_arr:
  vars@ ptk@ getq dup not 'puvv if
  psh call adv call adv call pexpr "]" expect
  spop "%s@ + loadx 255 and " fmt call emit "" lasts! 0 ret
pp_vr:
  vars@ ptk@ getq dup not 'puvv2 if
  dup lasts! "%s@ " fmt call emit call adv 0 ret
puvv: "unknown array variable" call die
puvv2: drop "undefined variable: " ptk@ cat "\n" cat call die

; ---- statement parser ----
pstmt:
  call tk call istype 'p_decl 'ps_0 ifelse ret
ps_0: call tk "return" call streq 'p_return 'ps_1 ifelse 0 ret
ps_1: call tk "if" call streq 'p_if 'ps_2 ifelse 0 ret
ps_2: call tk "while" call streq 'p_while 'ps_3 ifelse 0 ret
ps_3: call tk "for" call streq 'p_for 'ps_4 ifelse 0 ret
ps_4: call tk "do" call streq 'p_do 'ps_5 ifelse 0 ret
ps_5: call tk "break" call streq 'p_break 'ps_6 ifelse 0 ret
ps_6: call tk "continue" call streq 'p_continue 'ps_7 ifelse 0 ret
ps_7: call tk "{" call streq 'p_block 'ps_8 ifelse 0 ret
ps_8: call tk ";" call streq 'p_empty 'p_exprstmt ifelse 0 ret

; declaration
p_decl:
  call ptype
  call pd_var
  'pdc_c 'pdc_b while
  ";" expect 0 ret
pdc_c: call tk "," call streq ret
pdc_b: call adv call pd_var 0 ret
pd_var:
  call tk nv! call adv nv@ call newvar slot!
  call tk "=" call streq 'pdv_init 'pdv_done ifelse ret
pdv_init: call adv slot@ psh call passign spop slot2! slot2@ "%s!\n" fmt call emit 0 ret
pdv_done: 0 ret

; return
p_return:
  call adv call pexpr ";" expect
  inmain@ 'pr_main 'pr_func ifelse 0 ret
pr_main: "call exit\n" call emit 0 ret
pr_func: "ret\n" call emit 0 ret

; if / if-else
p_if:
  call adv "(" expect call pexpr ")" expect
  call newlbl tlbl!
  inq@ lpush
  tlbl@ lpush
  1 inq!
  "_i" tlbl@ "%d" fmt cat ":\n" cat call emit
  call pstmt
  "0 ret\n" call emit
  call tk "else" call streq 'pif_else 'pif_noelse ifelse 0 ret
pif_else:
  call newlbl elbl!
  elbl@ lpush
  "_e" elbl@ "%d" fmt cat ":\n" cat call emit
  call adv call pstmt "0 ret\n" call emit
  lpop elbl!
  lpop tlbl!
  lpop inq!
  "'_i" tlbl@ "%d" fmt cat " '_e" cat elbl@ "%d" fmt cat " ifelse\n" cat cat call emit
  0 ret
pif_noelse:
  lpop tlbl!
  lpop inq!
  "'_i" tlbl@ "%d" fmt cat " if\n" cat call emit
  0 ret

; while
p_while:
  call adv
  call newlbl clbl!
  call newlbl blbl!
  inq@ lpush
  clbl@ lpush
  blbl@ lpush
  1 inq!
  "_c" clbl@ "%d" fmt cat ":\n" cat call emit
  "(" expect call pexpr ")" expect
  "ret\n" call emit
  "_b" blbl@ "%d" fmt cat ":\n" cat call emit
  call pstmt
  "0 ret\n" call emit
  lpop blbl!
  lpop clbl!
  lpop inq!
  "'_c" clbl@ "%d" fmt cat " '_b" blbl@ "%d" fmt cat " while\n" cat cat call emit
  0 ret

; for
p_for:
  call adv "(" expect
  call newlbl fclbl!
  call newlbl fblbl!
  call tk ";" call streq 'pfi_skip 'pfi_check ifelse
  inq@ lpush
  fclbl@ lpush
  fblbl@ lpush
  1 inq!
  "_c" fclbl@ "%d" fmt cat ":\n" cat call emit
  call tk ";" call streq 'pfc_skip 'pfc_do ifelse
  "ret\n" call emit
  "_b" fblbl@ "%d" fmt cat ":\n" cat call emit
  pi@ pfpi!
  1 pfd!
  'pfs_c 'pfs_b while
  ")" expect
  call pstmt
  pi@ pfpi2!
  pfpi@ pi!
  call tk ")" call streq 'pfp_none 'pfp_do ifelse
  pfpi2@ pi!
  "0 ret\n" call emit
  lpop fblbl!
  lpop fclbl!
  lpop inq!
  "'_c" fclbl@ "%d" fmt cat " '_b" fblbl@ "%d" fmt cat " while\n" cat cat call emit
  0 ret
pfi_skip: call adv 0 ret
pfi_check: call tk call istype 'pfi_decl 'pfi_expr ifelse 0 ret
pfi_decl:
  call ptype call tk nv! call adv nv@ call newvar slot!
  "=" expect slot@ psh call passign spop slot2! slot2@ "%s!\n" fmt call emit
  ";" expect 0 ret
pfi_expr: call pexpr "drop\n" call emit ";" expect 0 ret
pfc_skip: call adv "1 " call emit 0 ret
pfc_do: call pexpr ";" expect 0 ret
pfs_c: pfd@ ret
pfs_b: call tk "(" call streq 'pfs_lp 'pfs_n1 ifelse 0 ret
pfs_lp: pfd@ 1 + pfd! call adv 0 ret
pfs_n1: call tk ")" call streq 'pfs_rp 'pfs_adv ifelse 0 ret
pfs_rp: pfd@ 1 - pfd! pfd@ 'pfs_adv2 'pfs_stop ifelse 0 ret
pfs_stop: 0 ret
pfs_adv2: call adv 0 ret
pfs_adv: call adv 0 ret
pfp_none: 0 ret
pfp_do: call pexpr "drop\n" call emit 0 ret

; do-while
p_do:
  call adv
  call newlbl dflbl!
  call newlbl clbl!
  call newlbl blbl!
  "1 _df" dflbl@ "%d" fmt cat cat "!\n" cat call emit
  inq@ lpush
  dflbl@ lpush
  clbl@ lpush
  blbl@ lpush
  1 inq!
  "_b" blbl@ "%d" fmt cat ":\n" cat call emit
  "0 _df" dflbl@ "%d" fmt cat cat "!\n" cat call emit
  call pstmt
  "0 ret\n" call emit
  "while" expect "(" expect
  "_c" clbl@ "%d" fmt cat ":\n" cat call emit
  "_df" dflbl@ "%d" fmt cat "@ " cat call emit
  call pexpr
  " or ret\n" call emit
  ")" expect ";" expect
  lpop blbl!
  lpop clbl!
  lpop dflbl!
  lpop inq!
  "'_c" clbl@ "%d" fmt cat " '_b" blbl@ "%d" fmt cat " while\n" cat cat call emit
  0 ret

; break / continue
p_break: call adv ";" expect "break\n" call emit 0 ret
p_continue: call adv ";" expect "cont\n" call emit 0 ret

; block
p_block: call adv 'pbl_c 'pbl_b while call adv 0 ret
pbl_c: call tk "}" call streq not ret
pbl_b: call pstmt 0 ret

; empty / expression statement
p_empty: call adv 0 ret
p_exprstmt: call pexpr "drop\n" call emit ";" expect 0 ret

; ---- function / program parser ----
pfunc:
  call ptype
  call tk fname! call adv
  "(" expect
  list pl!
  'pfp_c 'pfp_b while
  call adv
  dict vars!
  "" qout!
  fname@ "main" call streq 'pf_entry 'pf_noentry ifelse
  fname@ "%s:\n" fmt call emit
  fname@ "main" call streq inmain!
  pl@ len 1 - pfi!
  'pfp2_c 'pfp2_b while
  "{" expect
  'pfb_c 'pfb_b while
  call adv
  inmain@ 'pf_main_ep 'pf_func_ep ifelse
  qout@ "%s" print drop
  "" qout!
  ret
pf_entry: "entry:\n" call emit 0 ret
pf_noentry: 0 ret
pfp_c: call tk ")" call streq not ret
pfp_b: call tk "," call streq 'pfp_cma 'pfp_n1 ifelse 0 ret
pfp_cma: call adv 0 ret
pfp_n1: call tk call istype call tk "*" call streq + 'pfp_type 'pfp_name ifelse 0 ret
pfp_type: call adv 0 ret
pfp_name: pl@ call tk push pl! call adv 0 ret
pfp2_c: pfi@ -1 eq not ret
pfp2_b: pl@ pfi@ get nv! nv@ call newvar "%s!\n" fmt call emit pfi@ 1 - pfi! 0 ret
pfb_c: call tk "}" call streq not ret
pfb_b: call pstmt 0 ret
pf_main_ep: "0 call exit\n" call emit 0 ret
pf_func_ep: "0 ret\n" call emit 0 ret

pprog: 'pp_c 'pp_b while ret
pp_c: pi@ nt@ eq not ret
pp_b: call pfunc 0 ret

; ---- entry point ----
entry:
  0 inq!
  extern "uf_argc" loadx 2 eq not 'arg_bad if
  extern "uf_argv" loadx 8 + loadx path!
  path@ "r" call fopen f!
  f@ not 'ffail if
  f@ 0 2 call fseek drop
  f@ call ftell srclen!
  f@ 0 0 call fseek drop
  srclen@ 16 + buf src!
  src@ 1 srclen@ f@ call fread drop
  f@ call fclose drop
  list toks!
  0 pos!
  'lexl_c 'lexl_b while
  toks@ len nt!
  0 pi! 0 lbl! 0 fid! 0 inmain!
  list ps! list ls!
  "import c\"printf\"(ptr,...)->int\n" call emit
  "import c\"malloc\"(int)->ptr\n" call emit
  "import c\"free\"(ptr)->void\n" call emit
  "import c\"puts\"(ptr)->int\n" call emit
  "import c\"putchar\"(int)->int\n" call emit
  "import c\"getchar\"()->int\n" call emit
  "import c\"fputs\"(ptr,ptr)->int\n" call emit
  "import c\"fwrite\"(ptr,int,int,ptr)->int\n" call emit
  "import c\"strlen\"(ptr)->int\n" call emit
  "import c\"strcmp\"(ptr,ptr)->int\n" call emit
  "import c\"strncmp\"(ptr,ptr,int)->int\n" call emit
  "import c\"strcpy\"(ptr,ptr)->ptr\n" call emit
  "import c\"strcat\"(ptr,ptr)->ptr\n" call emit
  "import c\"exit\"(int)->void\n" call emit
  "import c\"fopen\"(ptr,ptr)->ptr\n" call emit
  "import c\"fclose\"(ptr)->int\n" call emit
  "import c\"fgetc\"(ptr)->int\n" call emit
  "extern \"stdout\"\n" call emit
  call pprog
  0 call exit
arg_bad: "usage: trans file.c" call die
ffail: "cannot open input" call die

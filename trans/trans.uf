; trans.uf — C subset -> uFlux v11 text-encoding transpiler, written in uFlux
; v11: all variables are global (^name); no jmp/jz/je; emits if/ifelse/while + native comparison opcodes
import c"printf"(ptr,...)->int
import c"malloc"(int)->ptr
import c"fopen"(ptr,ptr)->ptr
import c"fseek"(ptr,int,int)->int
import c"ftell"(ptr)->int
import c"fread"(ptr,int,int,ptr)->int
import c"fclose"(ptr)->int
import c"puts"(ptr)->int
import c"exit"(int)->void
import c"strlen"(ptr)->int
import c"strcmp"(ptr,ptr)->int
import c"strcpy"(ptr,ptr)->ptr

; ---- macros (must precede first use) ----
macro em { _call emit }
macro emn { _call emitn }
macro psh { ^ps@ swp push ^ps! }
macro spop { ^ps@ pop }
macro speek { ^ps@ dup len 1 - get }
macro expect { e! _call tk e@ _call streq not 'exf if _call adv }

; ---- output buffering (macros) ----
macro lpush { ^ls@ swp push ^ls! }
macro lpop { ^ls@ pop }
; ---- output buffering ----
emit: ^s!
  ^inq@ 'em_q 'em_o ifelse
  ret
em_o: ^s@ "%s" print drop 0 ret
em_q: ^qout@ ^s@ cat ^qout! 0 ret
emitn: ^n!
  ^n@ "%d" fmt ^sn!
  ^inq@ 'en_q 'en_o ifelse
  ret
en_o: ^sn@ "%s" print drop 0 ret
en_q: ^qout@ ^sn@ cat ^qout! 0 ret

; ---- leaf utilities ----
streq: ^b2! ^a2! ^a2@ ^b2@ _call strcmp not ret
die: _call puts 1 _call exit ret
tk: ^toks@ ^pi@ get ret
tk1: ^toks@ ^pi@ 1 + get ret
adv: ^pi@ 1 + ^pi! ret
newlbl: ^lbl@ 1 + ^lbl! ^lbl@ ret
exf: "parse error: expected " e@ cat " got " cat _call tk cat "\n" cat _call die

istype: ^it!
  ^it@ "int" _call streq ^it@ "char" _call streq + ^it@ "void" _call streq +
  ^it@ "long" _call streq + ^it@ "short" _call streq + ^it@ "unsigned" _call streq +
  ^it@ "signed" _call streq + ^it@ "const" _call streq + ^it@ "static" _call streq +
  ret

ptype: 'ptc 'ptb while ret
ptc: _call tk _call istype _call tk "*" _call streq + ret
ptb: _call adv 0 ret

newvar: ^nv!
  "v" ^fid@ "%d" fmt cat ^nv2!
  ^fid@ 1 + ^fid!
  ^vars@ ^nv@ ^nv2@ set
  ^nv2@ ret

findvar: ^nv!
  ^vars@ ^nv@ getq dup not 'fvno if ret
fvno: drop "undefined variable: " ^nv@ cat "\n" cat _call die

; trymatch: pat -> match length at pos, or -1
trymatch: ^tm_pat!
  ^src@ ^pos@ ^srclen@ slice ^tm_pat@ match 'tm_yes 'tm_no ifelse
  ^tmr@ ret
tm_yes: 0 get _call strlen ^tmr! 0 ret
tm_no: drop -1 ^tmr! 0 ret

; ---- lexer ----
lexl_c:
  'skp_c 'skp_b while
  ^pos@ ^srclen@ lt ret
lexl_b:
  ^src@ ^pos@ ^srclen@ slice ^rest!
  ^rest@ "^\"([^\"\\\\]|\\\\.)*\"" _call trymatch dup -1 eq not 'lex_str 'lex_n1 ifelse
  0 ret
lex_str: ^ln! _call lput 0 ret
lex_n1: drop
  ^rest@ "^'([^'\\\\]|\\\\.)*'" _call trymatch dup -1 eq not 'lex_chr 'lex_n2 ifelse
  0 ret
lex_chr: ^ln! _call lput 0 ret
lex_n2: drop
  ^rest@ "^(0[xX][0-9a-fA-F]+|[0-9]+)" _call trymatch dup -1 eq not 'lex_num 'lex_n3 ifelse
  0 ret
lex_num: ^ln! _call lput 0 ret
lex_n3: drop
  ^rest@ "^[A-Za-z_][A-Za-z0-9_]*" _call trymatch dup -1 eq not 'lex_id 'lex_n4 ifelse
  0 ret
lex_id: ^ln! _call lput 0 ret
lex_n4: drop
  ^rest@ "^(<<=|>>=|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|\\+=|-=|\\*=|/=|%=|<<|>>)" _call trymatch dup -1 eq not 'lex_mop 'lex_n5 ifelse
  0 ret
lex_mop: ^ln! _call lput 0 ret
lex_n5: drop 1 ^ln! _call lput 0 ret
lput: ^src@ ^pos@ ^pos@ ^ln@ + slice ^toks@ swp push ^toks! ^pos@ ^ln@ + ^pos! ret

; skip phase
skp_c:
  ^src@ ^pos@ ^srclen@ slice ^rest!
  ^rest@ "^[\t\n\r ]+" _call trymatch -1 eq not
  ^rest@ "//" starts +
  ^rest@ "/*" starts +
  ^rest@ "#" starts +
  ret
skp_b:
  ^rest@ "^[\t\n\r ]+" _call trymatch dup -1 eq not 'sb_ws 'sb_n1 ifelse 0 ret
sb_ws: ^pos@ + ^pos! 0 ret
sb_n1: drop ^rest@ "//" starts 'sb_lc 'sb_n2 ifelse 0 ret
sb_lc: ^rest@ "\n" find dup -1 eq 'sb_lc_eof 'sb_lc_nl ifelse 0 ret
sb_lc_nl: ^pos@ + 1 + ^pos! 0 ret
sb_lc_eof: drop ^srclen@ ^pos! 0 ret
sb_n2: drop ^rest@ "/*" starts 'sb_bc 'sb_n3 ifelse 0 ret
sb_bc: ^rest@ "*/" find dup -1 eq 'sb_bc_eof 'sb_bc_end ifelse 0 ret
sb_bc_end: ^pos@ + 2 + ^pos! 0 ret
sb_bc_eof: drop ^srclen@ ^pos! 0 ret
sb_n3: drop ^rest@ "#" starts 'sb_pp 'sb_done ifelse 0 ret
sb_pp: ^rest@ "\n" find dup -1 eq 'sb_pp_eof 'sb_pp_nl ifelse 0 ret
sb_pp_nl: ^pos@ + 1 + ^pos! 0 ret
sb_pp_eof: drop ^srclen@ ^pos! 0 ret
sb_done: 0 ret

; ---- expression parser ----
pexpr: _call passign ret

passign:
  ^vars@ _call tk getq dup not 'pa_plor 'pa_cdr ifelse ret
pa_plor: drop _call plor 0 ret
pa_cdr:
  psh _call tk1 psh
  speek "=" _call streq speek "+=" _call streq + speek "-=" _call streq +
  speek "*=" _call streq + speek "/=" _call streq + speek "%=" _call streq +
  not 'pa_na 'pa_as ifelse 0 ret
pa_na: spop drop spop drop _call plor 0 ret
pa_as:
  speek "/=" _call streq speek "%=" _call streq + 'pa_die if
  speek "=" _call streq 'pa_simple 'pa_compound ifelse 0 ret
pa_simple:
  _call adv _call adv _call passign "dup " _call emit
  spop drop spop "^%s!\n" fmt _call emit 0 ret
pa_compound:
  _call adv _call adv ^ps@ dup len 2 - get "^%s@ " fmt _call emit _call passign
  speek 0 1 slice _call emit " dup " _call emit spop drop
  spop "^%s!\n" fmt _call emit 0 ret
pa_die: "no division in subset" _call die

plor: _call pland 'plo_c 'plo_b while ret
plo_c: _call tk "||" _call streq ret
plo_b: _call adv _call pland "not not swp not not or " _call emit 0 ret

pland: _call peq 'pla_c 'pla_b while ret
pla_c: _call tk "&&" _call streq ret
pla_b: _call adv _call peq "not not swp not not and " _call emit 0 ret

peq: _call prel 'peq_c 'peq_b while ret
peq_c: _call tk "==" _call streq _call tk "!=" _call streq + ret
peq_b: _call tk "==" _call streq 'peq_eq 'peq_ne ifelse 0 ret
peq_eq: _call adv _call prel "eq " _call emit 0 ret
peq_ne: _call adv _call prel "eq not " _call emit 0 ret

prel: _call padd 'prl_c 'prl_b while ret
prl_c: _call tk "<" _call streq _call tk "<=" _call streq + _call tk ">" _call streq + _call tk ">=" _call streq + ret
prl_b: _call tk "<" _call streq 'prl_lt 'prl_n1 ifelse 0 ret
prl_lt: _call adv _call padd "lt " _call emit 0 ret
prl_n1: _call tk "<=" _call streq 'prl_le 'prl_n2 ifelse 0 ret
prl_le: _call adv _call padd "gt not " _call emit 0 ret
prl_n2: _call tk ">" _call streq 'prl_gt 'prl_ge ifelse 0 ret
prl_gt: _call adv _call padd "gt " _call emit 0 ret
prl_ge: _call adv _call padd "lt not " _call emit 0 ret

padd: _call pmul 'pad_c 'pad_b while ret
pad_c: _call tk "+" _call streq _call tk "-" _call streq + ret
pad_b: _call tk "+" _call streq 'pad_plus 'pad_minus ifelse 0 ret
pad_plus: _call adv _call pmul "+ " _call emit 0 ret
pad_minus: _call adv _call pmul "- " _call emit 0 ret

pmul: _call punary 'pm_c 'pm_b while
  _call tk "/" _call streq _call tk "%" _call streq + 'pm_die if
  ret
pm_c: _call tk "*" _call streq ret
pm_b: _call adv _call punary "* " _call emit 0 ret
pm_die: "no division in subset" _call die

punary:
  _call tk "-" _call streq 'pu_neg 'pu_c1 ifelse ret
pu_c1: _call tk "!" _call streq 'pu_not 'pu_c2 ifelse 0 ret
pu_c2: _call tk "~" _call streq 'pu_bnot 'pu_c3 ifelse 0 ret
pu_c3: _call tk "+" _call streq 'pu_pos 'pu_c4 ifelse 0 ret
pu_c4: _call tk "++" _call streq 'pu_inc 'pu_c5 ifelse 0 ret
pu_c5: _call tk "--" _call streq 'pu_dec 'pu_post ifelse 0 ret
pu_neg: _call adv "0 " _call emit _call punary "- " _call emit 0 ret
pu_not: _call adv _call punary "not " _call emit 0 ret
pu_bnot: _call adv _call punary "-1 swp - " _call emit 0 ret
pu_pos: _call adv _call punary 0 ret
pu_inc:
  _call adv ^vars@ _call tk getq dup not 'pu_inc_e if
  _call adv dup "^%s@ 1 + dup ^%s! " fmt _call emit 0 ret
pu_inc_e: "++ needs a variable" _call die
pu_dec:
  _call adv ^vars@ _call tk getq dup not 'pu_dec_e if
  _call adv dup "^%s@ 1 - dup ^%s! " fmt _call emit 0 ret
pu_dec_e: "-- needs a variable" _call die
; postfix ++/--: use if instead of while to avoid nested while issues
pu_post: "" ^lasts! _call pprim _call tk "++" _call streq 'pun_inc 'pun_chk2 ifelse 0 ret
pun_chk2: _call tk "--" _call streq 'pun_dec 'pun_done ifelse 0 ret
pun_inc:
  ^lasts@ "" _call streq 'pp_inc_err if
  _call adv ^lasts@ dup "^%s@ 1 + ^%s! " fmt _call emit 0 ret
pp_inc_err: "postfix ++ needs a variable" _call die
pun_dec:
  ^lasts@ "" _call streq 'pp_dec_err if
  _call adv ^lasts@ dup "^%s@ 1 - ^%s! " fmt _call emit 0 ret
pp_dec_err: "postfix -- needs a variable" _call die
pun_done: 0 ret

pprim: _call tk ^ptk!
  ^ptk@ "[0-9]*" glob 'pp_num 'pp_n1 ifelse ret
pp_n1: ^ptk@ "'" starts 'pp_char 'pp_n2 ifelse 0 ret
pp_n2: ^ptk@ "\"" starts 'pp_str 'pp_n3 ifelse 0 ret
pp_n3: ^ptk@ "(" _call streq 'pp_paren 'pp_n4 ifelse 0 ret
pp_n4: ^ptk@ "argc" _call streq 'pp_argc 'pp_n5 ifelse 0 ret
pp_n5: ^ptk@ "argv" _call streq 'pp_argv 'pp_n6 ifelse 0 ret
pp_n6: ^ptk@ "__byte" _call streq 'pp_byte 'pp_n7 ifelse 0 ret
pp_n7: ^ptk@ "NULL" _call streq 'pp_null 'pp_n8 ifelse 0 ret
pp_n8: ^ptk@ "EOF" _call streq 'pp_eof 'pp_n9 ifelse 0 ret
pp_n9: _call tk1 "(" _call streq 'pp_func 'pp_var ifelse 0 ret

pp_num:
  ^ptk@ "^(0[xX][0-9a-fA-F]+|[0-9]+)" match drop 0 get _call emit " " _call emit _call adv 0 ret
pp_str: ^ptk@ _call emit " " _call emit _call adv "" ^lasts! 0 ret
pp_paren: _call adv _call pexpr ")" expect "" ^lasts! 0 ret
pp_argc: _call adv "extern \"uf_argc\" loadx " _call emit "" ^lasts! 0 ret
pp_argv: _call adv "[" expect _call pexpr "]" expect
  "extern \"uf_argv\" loadx swp 8 * + loadx " _call emit "" ^lasts! 0 ret
pp_byte: _call adv "(" expect _call pexpr ")" expect "loadx 255 and " _call emit "" ^lasts! 0 ret
pp_null: _call adv "0 " _call emit "" ^lasts! 0 ret
pp_eof: _call adv "-1 " _call emit "" ^lasts! 0 ret

pp_char:
  ^ptk@ 1 ^ptk@ _call strlen 1 - slice ^ci!
  ^ci@ "\\" starts 'pp_esc 'pp_charlit ifelse 0 ret
pp_charlit: ^ci@ loadx 255 and _call emitn " " _call emit _call adv 0 ret
pp_esc:
  ^ci@ "\\n" _call streq 'pe_n 'pe_t1 ifelse 0 ret
pe_n: 10 _call emitn " " _call emit _call adv 0 ret
pe_t1: ^ci@ "\\t" _call streq 'pe_t 'pe_r1 ifelse 0 ret
pe_t: 9 _call emitn " " _call emit _call adv 0 ret
pe_r1: ^ci@ "\\r" _call streq 'pe_r 'pe_01 ifelse 0 ret
pe_r: 13 _call emitn " " _call emit _call adv 0 ret
pe_01: ^ci@ "\\0" _call streq 'pe_0 'pe_bs1 ifelse 0 ret
pe_0: 0 _call emitn " " _call emit _call adv 0 ret
pe_bs1: ^ci@ "\\\\" _call streq 'pe_bs 'pe_sq1 ifelse 0 ret
pe_bs: 92 _call emitn " " _call emit _call adv 0 ret
pe_sq1: ^ci@ "\\'" _call streq 'pe_sq 'pe_bad ifelse 0 ret
pe_sq: 39 _call emitn " " _call emit _call adv 0 ret
pe_bad: "bad char escape" _call die

pp_func:
  ^ptk@ psh _call adv _call adv
  _call tk ")" _call streq 'ppf_noargs 'ppf_args ifelse
  ")" expect spop "_call %s " fmt _call emit "" ^lasts! 0 ret
ppf_noargs: 0 ret
ppf_args: _call pexpr 'ppf_c 'ppf_b while 0 ret
ppf_c: _call tk "," _call streq ret
ppf_b: _call adv _call pexpr 0 ret

pp_var: _call tk1 "[" _call streq 'pp_arr 'pp_vr ifelse 0 ret
pp_arr:
  ^vars@ ^ptk@ getq dup not 'puvv if
  psh _call adv _call adv _call pexpr "]" expect
  spop "^%s@ + loadx 255 and " fmt _call emit "" ^lasts! 0 ret
pp_vr:
  ^vars@ ^ptk@ getq dup not 'puvv2 if
  dup ^lasts! "^%s@ " fmt _call emit _call adv 0 ret
puvv: "unknown array variable" _call die
puvv2: drop "undefined variable: " ^ptk@ cat "\n" cat _call die

; ---- statement parser ----
pstmt:
  _call tk _call istype 'p_decl 'ps_0 ifelse ret
ps_0: _call tk "return" _call streq 'p_return 'ps_1 ifelse 0 ret
ps_1: _call tk "if" _call streq 'p_if 'ps_2 ifelse 0 ret
ps_2: _call tk "while" _call streq 'p_while 'ps_3 ifelse 0 ret
ps_3: _call tk "for" _call streq 'p_for 'ps_4 ifelse 0 ret
ps_4: _call tk "do" _call streq 'p_do 'ps_5 ifelse 0 ret
ps_5: _call tk "break" _call streq 'p_break 'ps_6 ifelse 0 ret
ps_6: _call tk "continue" _call streq 'p_continue 'ps_7 ifelse 0 ret
ps_7: _call tk "{" _call streq 'p_block 'ps_8 ifelse 0 ret
ps_8: _call tk ";" _call streq 'p_empty 'p_exprstmt ifelse 0 ret

; declaration
p_decl:
  _call ptype
  _call pd_var
  'pdc_c 'pdc_b while
  ";" expect 0 ret
pdc_c: _call tk "," _call streq ret
pdc_b: _call adv _call pd_var 0 ret
pd_var:
  _call tk ^nv! _call adv ^nv@ _call newvar ^slot!
  _call tk "=" _call streq 'pdv_init 'pdv_done ifelse ret
pdv_init: _call adv ^slot@ psh _call passign spop ^slot2! ^slot2@ "^%s!\n" fmt _call emit 0 ret
pdv_done: 0 ret

; return
p_return:
  _call adv _call pexpr ";" expect
  ^inmain@ 'pr_main 'pr_func ifelse 0 ret
pr_main: "_call exit\n" _call emit 0 ret
pr_func: "ret\n" _call emit 0 ret

; if / if-else
p_if:
  _call adv "(" expect _call pexpr ")" expect
  _call newlbl ^tlbl!
  ^inq@ lpush
  ^tlbl@ lpush
  1 ^inq!
  "i" ^tlbl@ "%d" fmt cat ":\n" cat _call emit
  _call pstmt
  "0 ret\n" _call emit
  _call tk "else" _call streq 'pif_else 'pif_noelse ifelse 0 ret
pif_else:
  _call newlbl ^elbl!
  ^elbl@ lpush
  "e" ^elbl@ "%d" fmt cat ":\n" cat _call emit
  _call adv _call pstmt "0 ret\n" _call emit
  lpop ^elbl!
  lpop ^tlbl!
  lpop ^inq!
  "'i" ^tlbl@ "%d" fmt cat " 'e" cat ^elbl@ "%d" fmt cat " ifelse\n" cat cat _call emit
  0 ret
pif_noelse:
  lpop ^tlbl!
  lpop ^inq!
  "'i" ^tlbl@ "%d" fmt cat " if\n" cat _call emit
  0 ret

; while
p_while:
  _call adv
  _call newlbl ^clbl!
  _call newlbl ^blbl!
  ^inq@ lpush
  ^clbl@ lpush
  ^blbl@ lpush
  1 ^inq!
  "c" ^clbl@ "%d" fmt cat ":\n" cat _call emit
  "(" expect _call pexpr ")" expect
  "ret\n" _call emit
  "b" ^blbl@ "%d" fmt cat ":\n" cat _call emit
  _call pstmt
  "0 ret\n" _call emit
  lpop ^blbl!
  lpop ^clbl!
  lpop ^inq!
  "'c" ^clbl@ "%d" fmt cat " 'b" ^blbl@ "%d" fmt cat " while\n" cat cat _call emit
  0 ret

; for
p_for:
  _call adv "(" expect
  _call newlbl ^fclbl!
  _call newlbl ^fblbl!
  _call tk ";" _call streq 'pfi_skip 'pfi_check ifelse
  ^inq@ lpush
  ^fclbl@ lpush
  ^fblbl@ lpush
  1 ^inq!
  "c" ^fclbl@ "%d" fmt cat ":\n" cat _call emit
  _call tk ";" _call streq 'pfc_skip 'pfc_do ifelse
  "ret\n" _call emit
  "b" ^fblbl@ "%d" fmt cat ":\n" cat _call emit
  ^pi@ ^pfpi!
  1 ^pfd!
  'pfs_c 'pfs_b while
  ")" expect
  _call pstmt
  ^pi@ ^pfpi2!
  ^pfpi@ ^pi!
  _call tk ")" _call streq 'pfp_none 'pfp_do ifelse
  ^pfpi2@ ^pi!
  "0 ret\n" _call emit
  lpop ^fblbl!
  lpop ^fclbl!
  lpop ^inq!
  "'c" ^fclbl@ "%d" fmt cat " 'b" ^fblbl@ "%d" fmt cat " while\n" cat cat _call emit
  0 ret
pfi_skip: _call adv 0 ret
pfi_check: _call tk _call istype 'pfi_decl 'pfi_expr ifelse 0 ret
pfi_decl:
  _call ptype _call tk ^nv! _call adv ^nv@ _call newvar ^slot!
  "=" expect ^slot@ psh _call passign spop ^slot2! ^slot2@ "^%s!\n" fmt _call emit
  ";" expect 0 ret
pfi_expr: _call pexpr "drop\n" _call emit ";" expect 0 ret
pfc_skip: _call adv "1 " _call emit 0 ret
pfc_do: _call pexpr ";" expect 0 ret
pfs_c: ^pfd@ ret
pfs_b: _call tk "(" _call streq 'pfs_lp 'pfs_n1 ifelse 0 ret
pfs_lp: ^pfd@ 1 + ^pfd! _call adv 0 ret
pfs_n1: _call tk ")" _call streq 'pfs_rp 'pfs_adv ifelse 0 ret
pfs_rp: ^pfd@ 1 - ^pfd! ^pfd@ 'pfs_adv2 'pfs_stop ifelse 0 ret
pfs_stop: 0 ret
pfs_adv2: _call adv 0 ret
pfs_adv: _call adv 0 ret
pfp_none: 0 ret
pfp_do: _call pexpr "drop\n" _call emit 0 ret

; do-while
p_do:
  _call adv
  _call newlbl ^dflbl!
  _call newlbl ^clbl!
  _call newlbl ^blbl!
  "1 df" ^dflbl@ "%d" fmt cat cat "!\n" cat _call emit
  ^inq@ lpush
  ^dflbl@ lpush
  ^clbl@ lpush
  ^blbl@ lpush
  1 ^inq!
  "b" ^blbl@ "%d" fmt cat ":\n" cat _call emit
  "0 df" ^dflbl@ "%d" fmt cat cat "!\n" cat _call emit
  _call pstmt
  "0 ret\n" _call emit
  "while" expect "(" expect
  "c" ^clbl@ "%d" fmt cat ":\n" cat _call emit
  "df" ^dflbl@ "%d" fmt cat "@ " cat _call emit
  _call pexpr
  " or ret\n" _call emit
  ")" expect ";" expect
  lpop ^blbl!
  lpop ^clbl!
  lpop ^dflbl!
  lpop ^inq!
  "'c" ^clbl@ "%d" fmt cat " 'b" ^blbl@ "%d" fmt cat " while\n" cat cat _call emit
  0 ret

; break / continue
p_break: _call adv ";" expect "break\n" _call emit 0 ret
p_continue: _call adv ";" expect "cont\n" _call emit 0 ret

; block
p_block: _call adv 'pbl_c 'pbl_b while _call adv 0 ret
pbl_c: _call tk "}" _call streq not ret
pbl_b: _call pstmt 0 ret

; empty / expression statement
p_empty: _call adv 0 ret
p_exprstmt: _call pexpr "drop\n" _call emit ";" expect 0 ret

; ---- function / program parser ----
pfunc:
  _call ptype
  _call tk ^fname! _call adv
  "(" expect
  list ^pl!
  'pfp_c 'pfp_b while
  _call adv
  dict ^vars!
  "" ^qout!
  ^fname@ "main" _call streq 'pf_entry 'pf_noentry ifelse
  ^fname@ "%s:\n" fmt _call emit
  ^fname@ "main" _call streq ^inmain!
  ^pl@ len 1 - ^pfi!
  'pfp2_c 'pfp2_b while
  "{" expect
  'pfb_c 'pfb_b while
  _call adv
  ^inmain@ 'pf_main_ep 'pf_func_ep ifelse
  ^qout@ "%s" print drop
  "" ^qout!
  ret
pf_entry: "entry:\n" _call emit 0 ret
pf_noentry: 0 ret
pfp_c: _call tk ")" _call streq not ret
pfp_b: _call tk "," _call streq 'pfp_cma 'pfp_n1 ifelse 0 ret
pfp_cma: _call adv 0 ret
pfp_n1: _call tk _call istype _call tk "*" _call streq + 'pfp_type 'pfp_name ifelse 0 ret
pfp_type: _call adv 0 ret
pfp_name: ^pl@ _call tk push ^pl! _call adv 0 ret
pfp2_c: ^pfi@ -1 eq not ret
pfp2_b: ^pl@ ^pfi@ get ^nv! ^nv@ _call newvar "^%s!\n" fmt _call emit ^pfi@ 1 - ^pfi! 0 ret
pfb_c: _call tk "}" _call streq not ret
pfb_b: _call pstmt 0 ret
pf_main_ep: "0 _call exit\n" _call emit 0 ret
pf_func_ep: "0 ret\n" _call emit 0 ret

pprog: 'pp_c 'pp_b while ret
pp_c: ^pi@ ^nt@ eq not ret
pp_b: _call pfunc 0 ret

; ---- entry point ----
entry:
  0 ^inq!
  extern "uf_argc" loadx 2 eq not 'arg_bad if
  extern "uf_argv" loadx 8 + loadx ^path!
  ^path@ "r" _call fopen ^f!
  ^f@ not 'ffail if
  ^f@ 0 2 _call fseek drop
  ^f@ _call ftell ^srclen!
  ^f@ 0 0 _call fseek drop
  ^srclen@ 16 + buf ^src!
  ^src@ 1 ^srclen@ ^f@ _call fread drop
  ^f@ _call fclose drop

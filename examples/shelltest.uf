; shelltest.uf — shell ops demo (text encoding; .uf is fine, detection is content-based)
; SH + split: capture producer output, print line count and first line
"printf 'alpha\\nbeta\\ngamma\\n'" sh drop drop trim "\n" split lines!
lines@ len "lines=%d\n" print drop
lines@ 0 get "first=%s\n" print drop
; SHP: streaming producer drained by a DEQ loop with an ATOM counter
0 atom n!
"for i in 1 2 3 4 5; do echo line$i; sleep 0.05; done" shp ch!
'cond 'body while
n@ aget "count=%d\n" print drop
; EXEC: argv list, no shell
list "echo" push "exec-works" push exec "exec-status=%d\n" print drop
; SH: stderr capture + status
"echo out; echo err 1>&2; exit 7" sh "sh-status=%d\n" print drop "sh-err=%s" print drop "sh-out=%s" print drop
; SH: fire-and-forget, status only (drop captured output)
"exit 0" sh "sh-status=%d\n" print drop drop drop
ret
cond:
  ch@ deq dup msg! ret
body:
  msg@ "got: %s\n" print drop
  n@ 1 aadd drop
  0 ret

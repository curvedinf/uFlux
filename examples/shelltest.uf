; shelltest.uf — shell ops demo (text encoding; .uf is fine, detection is content-based)
; SHL: capture producer output, print line count and first line
"printf 'alpha\\nbeta\\ngamma\\n'" shl lines!
lines@ len "lines=%d\n" print drop
lines@ 0 idx "first=%s\n" print drop
; SHP: streaming producer drained by a DEQ loop with an ATOM counter
0 atom n!
"for i in 1 2 3 4 5; do echo line$i; sleep 0.05; done" shp ch!
loop:
  ch@ deq dup jz done
  "got: %s\n" print drop
  n@ 1 aadd drop
  jmp loop
done:
  drop
n@ aget "count=%d\n" print drop
; EXEC: argv list, no shell
list "echo" append "exec-works" append exec "exec-status=%d\n" print drop
; SHX: stderr capture + status
"echo out; echo err 1>&2; exit 7" shx "shx-status=%d\n" print drop "shx-err=%s" print drop "shx-out=%s" print drop
; SH: inherited stdio, status only
"exit 0" sh "sh-status=%d\n" print drop

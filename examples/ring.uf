; ring.uf — producer/consumer over CHAN, ATOM counter, sum=5050
8 chan cq! 0 atom ac!
weave
  task prod
    1 i!
    'pcond 'pbody while
    cq@ close
    pcond:
      i@ 101 lt ret
    pbody:
      cq@ i@ enq
      i@ 1 + i!
      0 ret
  endt
  task cons
    'ccond 'cbody while
    ccond:
      cq@ deq dup val! val@ 0 gt ret
    cbody:
      ac@ val@ aadd drop
      0 ret
  endt
wrun
ac@ aget "sum=%d\n" print drop
